{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/product-loop",
  "title": "Product Loop",
  "category": "widgets",
  "icon": "products",
  "description": "A grid of WooCommerce products: choose how many, in what order (newest, best selling, top rated and so on), and which categories to include or leave out. Optionally with a section heading, description, \"View all\" link and a section theme. Uses the shop's own product cards. Replaces the Recent Products, Best Selling Products and Featured Products blocks (set Show to the featured products).",
  "keywords": [
    "woocommerce",
    "shop",
    "products",
    "loop",
    "grid"
  ],
  "textdomain": "sage",
  "attributes": {
    "limit": {
      "type": "number",
      "default": 8
    },
    "columns": {
      "type": "number",
      "default": 4
    },
    "orderby": {
      "type": "string",
      "default": "menu_order"
    },
    "order": {
      "type": "string",
      "default": "ASC"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "excludeCategories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "source": {
      "type": "string",
      "enum": [
        "all",
        "featured",
        "onsale"
      ],
      "default": "all"
    },
    "viewAll": {
      "type": "boolean",
      "default": false
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "cardStyle": {
      "type": "string",
      "default": "white"
    },
    "cardTheme": {
      "type": "string",
      "default": ""
    },
    "cardButton": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "enum": [
        "grid",
        "rail",
        "feature",
        "intro"
      ],
      "default": "grid"
    },
    "viewAllTab": {
      "type": "string",
      "enum": [
        "",
        "tab",
        "pinned",
        "link"
      ],
      "default": ""
    },
    "cardLook": {
      "type": "string",
      "enum": [
        "",
        "tiles",
        "centred"
      ],
      "default": ""
    },
    "headingTab": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "render": "file:./render.php"
}
