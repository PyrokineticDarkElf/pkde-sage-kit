{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/accordion",
  "title": "Accordion",
  "category": "widgets",
  "icon": "list-view",
  "description": "A stack of collapsible items \u2014 add an Accordion Item block for each one.",
  "keywords": [
    "accordion",
    "collapse",
    "toggle"
  ],
  "textdomain": "sage",
  "attributes": {
    "heading": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "columnThreshold": {
      "type": "number",
      "default": 5
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "cardStyle": {
      "type": "string",
      "default": "white"
    },
    "singleColumn": {
      "type": "boolean",
      "default": false
    },
    "look": {
      "type": "string",
      "enum": [
        "",
        "bars"
      ],
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "render": "file:./render.php"
}
