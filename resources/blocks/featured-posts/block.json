{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/featured-posts",
  "title": "Featured Posts",
  "category": "widgets",
  "icon": "star-filled",
  "description": "A grid of highlighted posts — either whatever is marked \"Stick to the front page\", or a manually chosen set.",
  "keywords": ["posts", "blog", "featured", "sticky"],
  "textdomain": "sage",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Featured Posts"
    },
    "description": {
      "type": "string",
      "default": "Posts stuck to the front page (or a manually chosen set)."
    },
    "source": {
      "type": "string",
      "default": "sticky"
    },
    "count": {
      "type": "number",
      "default": 3
    },
    "postIds": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "cardStyle": {
      "type": "string",
      "default": "white"
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "render": "file:./render.php"
}
