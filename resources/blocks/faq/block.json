{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/faq",
  "title": "FAQs",
  "category": "widgets",
  "icon": "editor-help",
  "description": "The FAQs of one or more FAQ groups, kept in the FAQs screen and shown here; one FAQPage structured data block per page. (Typing the questions into this block is deprecated.)",
  "keywords": ["faq", "questions", "accordion", "schema"],
  "textdomain": "sage",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Frequently asked questions"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "columnThreshold": {
      "type": "number",
      "default": 5
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "cardStyle": {
      "type": "string",
      "default": "white"
    },
    "groups": {
      "type": "array",
      "items": { "type": "integer" },
      "default": []
    },
    "order": {
      "type": "string",
      "enum": ["manual", "az"],
      "default": "manual"
    },
    "limit": {
      "type": "number",
      "default": 0
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "render": "file:./render.php"
}
