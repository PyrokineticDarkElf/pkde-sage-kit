{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/hero",
  "title": "Hero",
  "category": "design",
  "icon": "cover-image",
  "description": "A hero section with a heading, supporting text, an image and buttons: over a full-width image (the default), split (text beside the image) or text only. Split and text-only take their colours from the section they sit in.",
  "keywords": [
    "hero",
    "banner",
    "cover"
  ],
  "textdomain": "sage",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Your heading here",
      "__experimentalRole": "content"
    },
    "content": {
      "type": "string",
      "default": "A short supporting sentence goes here.",
      "__experimentalRole": "content"
    },
    "buttonText": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "buttonUrl": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "imageUrl": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "imageId": {
      "type": "number",
      "__experimentalRole": "content"
    },
    "imageAlt": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "overlay"
    },
    "imageSide": {
      "type": "string",
      "default": "right"
    },
    "imageFit": {
      "type": "string",
      "default": "cover"
    },
    "eyebrow": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "buttonStyle": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "text"
      ],
      "default": "primary"
    },
    "secondaryButtonStyle": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "text"
      ],
      "default": "secondary"
    },
    "secondaryButtonText": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "secondaryButtonUrl": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    },
    "placeholder": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "render": "file:./render.php"
}
