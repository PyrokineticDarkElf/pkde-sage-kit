{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/feature-grid",
  "title": "Feature grid",
  "category": "design",
  "icon": "grid-view",
  "description": "A heading and a grid of items: an icon or picture, a heading, a short text and an optional link. The People style is a row of picture cards (a badge, a name, a job title) that scrolls sideways, with an optional link under it, for a team. For benefits, services, steps, values or links to other pages. Takes its colours from the section it sits in.",
  "keywords": [
    "features",
    "benefits",
    "services",
    "cards",
    "grid",
    "icons"
  ],
  "textdomain": "sage",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "heading": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "intro": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "variant": {
      "type": "string",
      "default": "plain",
      "enum": [
        "plain",
        "cards",
        "steps",
        "stats",
        "people"
      ]
    },
    "centered": {
      "type": "boolean",
      "default": false
    },
    "templateLock": {
      "type": [
        "string",
        "boolean"
      ],
      "enum": [
        "all",
        "insert",
        "contentOnly",
        false
      ]
    },
    "cardTheme": {
      "type": "string",
      "default": ""
    },
    "cardButton": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": ""
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayDelay": {
      "type": "number",
      "default": 5000
    },
    "speed": {
      "type": "string",
      "enum": [
        "slow",
        "normal",
        "fast"
      ],
      "default": "normal"
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": true
  },
  "render": "file:./render.php"
}
