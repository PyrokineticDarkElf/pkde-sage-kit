{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/cta",
  "title": "CTA",
  "category": "widgets",
  "icon": "megaphone",
  "description": "A call-to-action section — heading, text, and up to two buttons. Two styles: a full section, or a compact banner strip. Optionally with a logo or picture beside the text.",
  "keywords": [
    "cta",
    "call to action",
    "banner"
  ],
  "textdomain": "sage",
  "attributes": {
    "style": {
      "type": "string",
      "default": "section"
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "content": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "primaryButtonText": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "primaryButtonUrl": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "buttonStyle": {
      "type": "string",
      "enum": ["primary", "secondary", "text"],
      "default": "primary"
    },
    "secondaryButtonStyle": {
      "type": "string",
      "enum": ["primary", "secondary", "text"],
      "default": "secondary"
    },
    "secondaryButtonText": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "secondaryButtonUrl": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "imageUrl": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    },
    "imageId": {
      "type": "number",
      "__experimentalRole": "content"
    },
    "imageAlt": {
      "type": "string",
      "default": "",
      "__experimentalRole": "content"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "render": "file:./render.php"
}
