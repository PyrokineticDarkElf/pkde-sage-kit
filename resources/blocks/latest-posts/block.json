{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/latest-posts",
  "title": "Recent Posts (Grid)",
  "category": "widgets",
  "icon": "grid-view",
  "description": "A grid of items from any post type (blog posts by default): the most recent, the sticky posts, or a listing of every entry in the order of their Order field. Optionally filtered to one category.",
  "keywords": [
    "posts",
    "blog",
    "recent",
    "latest"
  ],
  "textdomain": "sage",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Recent Posts"
    },
    "description": {
      "type": "string",
      "default": "The most recent blog posts, in a grid."
    },
    "count": {
      "type": "number",
      "default": 3
    },
    "postType": {
      "type": "string",
      "default": "post"
    },
    "categoryId": {
      "type": "number",
      "default": 0
    },
    "theme": {
      "type": "string",
      "default": ""
    },
    "cardStyle": {
      "type": "string",
      "default": "white"
    },
    "cardTheme": {
      "type": "string",
      "default": ""
    },
    "cardButton": {
      "type": "string",
      "default": ""
    },
    "source": {
      "type": "string",
      "enum": [
        "latest",
        "sticky",
        "manual"
      ],
      "default": "latest"
    },
    "layout": {
      "type": "string",
      "enum": [
        "cards",
        "feature",
        "list",
        "panel",
        "overlay",
        "label"
      ],
      "default": "cards"
    },
    "pinViewAll": {
      "type": "boolean",
      "default": false
    },
    "headingTab": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "render": "file:./render.php"
}
